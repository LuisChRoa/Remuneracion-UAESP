<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrega a operador: carpeta autocontenida win-x64 (la máquina destino NO necesita instalar .NET).

  Este perfil se mantiene DELIBERADAMENTE MÍNIMO, con la forma que genera Visual Studio, porque
  el botón "Publicar" de VS (capa WebTools) falla con propiedades no canónicas en el .pubxml
  (p. ej. AssemblyName a nivel de perfil) aunque MSBuild publique bien con ellas.

  Para el paquete de entrega completo (sin .pdb, con versión y comprimido) usa
  `publicar-operador.cmd`, que es la vía verificada.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishDir>bin\Release\net10.0-windows\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
