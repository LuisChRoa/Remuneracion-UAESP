<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Remuneracion.Core\Remuneracion.Core.csproj" />
    <ProjectReference Include="..\Remuneracion.Infrastructure\Remuneracion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HU-19.2: slogan con matte blanco puro (damero removido + recorte ajustado) embebido en el
         ensamblado (sin ruta absoluta ni dependencia de archivo en runtime). Supersede a
         Assets/slogan.jpg de HU-19.1, que se retira del proyecto. -->
    <EmbeddedResource Include="Assets\slogan-blanco.png" />
    <!-- Icono de la aplicación (monograma FN): el .exe lo usa vía ApplicationIcon y la ventana
         vía InicializarIcono (mismo archivo, recurso embebido). -->
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Icono del .exe: monograma FN (navy #161D37 + acento #3468A4). La ventana lo toma del
         mismo archivo vía EmbeddedResource + InicializarIcono (título correcto con dotnet run). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Entrega a operador (perfil Operador-win-x64): el restore debe conocer el RID, si no
         aparece NETSDK1047 al publicar autocontenido desde Visual Studio. Plural a propósito:
         el build normal sigue siendo agnóstico de plataforma. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
