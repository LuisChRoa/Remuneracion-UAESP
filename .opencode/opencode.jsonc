{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "remuneracion-architect",
  "agent": {
    "remuneracion-architect": {
      "mode": "primary",
      "model": "github-copilot/grok-4.6",
      "prompt": "{file:agents/remuneracion-architect.md}",

      "permission": {
        "task": {
          "*": "allow",
          "sdd-planner": "allow",
          "implementer": "allow",
          "code-reviewer": "allow",
          "debug-agent": "allow",
          "ui-ux-specialist": "allow",
          "explore": "allow",
          "general": "allow"
        }
      }
    }
  }
}
