<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Herramientas.PreparadorBasePeriodo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plan 39 (T1, D-C): la herramienta pasa a WRAPPER DELGADO del componente compartido
         `PreparadorBasePipeline` (Infrastructure/Excel), que es también la Phase 0 automática del
         pipeline. El componente es BCL puro (ZipArchive + Regex; sin OpenXML/ExcelDataReader/Excel/
         COM): la referencia a Infrastructure solo expone ese componente. Core sigue referenciado
         (el período viaja como `Periodo`). -->
    <ProjectReference Include="..\..\Remuneracion.Core\Remuneracion.Core.csproj" />
    <ProjectReference Include="..\..\Remuneracion.Infrastructure\Remuneracion.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Wrapper CLI delgado (Plan 39 T1; antes Plan 30 T3 D-B / Plan 36 T3). La cirugía de bytes vive
       en Infrastructure. Fuera del pipeline de runtime; deliberadamente NO se agrega al .slnx
       (mismo criterio que Herramientas/VerificadorRecaudo). -->

</Project>
